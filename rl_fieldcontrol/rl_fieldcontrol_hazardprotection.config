{
  // The JSON object's keys must be names of status effects that are
  // environmental hazards. Values must be JSON objects with a `stat`
  // string property that is the blocking stat of the status effect and
  // an `amount` numeric property that is positive, preferably 1.0.
  "biomecold" : { "stat" : "biomecoldImmunity", "amount" : 1.0 },
  "biomeheat" : { "stat" : "biomeheatImmunity", "amount" : 1.0 },
  "biomeradiation" : { "stat" : "biomeradiationImmunity", "amount" : 1.0 }
}
