{
  "animatedParts" : {
    "stateTypes" : {
      "consoleState" : {
        "default" : "unregistered",
        "states" : {
          "unregistered" : {
            "frames" : 2,
            "cycle" : 1,
            "mode" : "loop",
            "properties" : {
              "lightsOn" : ["activeGlow"]
            }
          },
          "shieldsdown" : {
            "frames" : 18,
            "cycle" : 1.8,
            "mode" : "loop",
            "properties" : {
              "lightsOn" : ["activeGlow"]
            }
          },
          "shieldsup" : {
            "frames" : 18,
            "cycle" : 1.8,
            "mode" : "loop",
            "properties" : {
              "lightsOn" : ["activeGlow"]
            }
          },
          "bulkhead" : {
            "properties" : {
              "lightsOff" : ["activeGlow"]
            }
          },
          "hidden" : {
            "properties" : {
              "lightsOff" : ["activeGlow"]
            }
          }
        }
      }
    },

    "parts" : {
      "bg" : {
        "properties" : {
          "centered" : false
        },

        "partStates" : {
          "consoleState" : {
            "unregistered" : {
              "properties" : {
                "image" : "<partImage>:unregistered.<frame>",
                "fullbright" : true
              }
            },
            "shieldsdown" : {
              "properties" : {
                "image" : "<partImage>:shieldsdown.<frame>",
                "fullbright" : true
              }
            },
            "shieldsup" : {
              "properties" : {
                "image" : "<partImage>:shieldsup.<frame>",
                "fullbright" : true
              }
            },
            "bulkhead" : {
              "properties" : {
                "image" : "<partImage>:bulkhead"
              }
            },
            "hidden" : {
              "properties" : {
                "image" : "<partImage>:hidden"
              }
            }
          }
        }
      },
      "fg" : {
        "properties" : {
          "centered" : false,
          "zLevel" : 1
        },

        "partStates" : {
          "consoleState" : {
            "unregistered" : {
              "properties" : {
                "image" : "<partImage>:default"
              }
            },
            "shieldsdown" : {
              "properties" : {
                "image" : "<partImage>:default"
              }
            },
            "shieldsup" : {
              "properties" : {
                "image" : "<partImage>:default"
              }
            },
            "bulkhead" : {
              "properties" : {
                "image" : "<partImage>:bulkhead"
              }
            },
            "hidden" : {
              "properties" : {
                "image" : "<partImage>:hidden"
              }
            }
          }
        }
      }
    }
  },

  "lights" : {
    "activeGlow" : {
      "active" : false,
      "position" : [1.5, 1.5],
      "color" : [46, 60, 77]
    }
  },

  "sounds" : {
    "register" : [ "/sfx/interface/energy_full2.ogg" ],
    "deregister" : [ "/sfx/interface/energy_out2.ogg" ],
    "shieldsUp" : [ "/sfx/interface/energy_full1.ogg" ],
    "shieldsDown" : [ "/sfx/interface/energy_out1.ogg" ]
  }
}
