{
  "animatedParts" : {
    "stateTypes" : {
      "switchState" : {
        "default" : "dead",
        "states" : {
          "dead" : {
            "properties" : {
              "lightsOff" : ["activeGlow", "errorGlow"]
            }
          },
          "off" : {
            "properties" : {
              "lightsOn" : ["activeGlow"],
              "lightsOff" : ["errorGlow"]
            }
          },
          "on" : {
            "frames" : 4,
            "cycle" : 0.5,
            "mode" : "loop",
            "properties" : {
              "lightsOn" : ["activeGlow"],
              "lightsOff" : ["errorGlow"]
            }
          },
          "error" : {
            "properties" : {
              "lightsOn" : ["errorGlow"],
              "lightsOff" : ["activeGlow"]
            }
          },
          "dup" : {
            "properties" : {
              "lightsOn" : ["errorGlow"],
              "lightsOff" : ["activeGlow"]
            }
          }
        }
      }
    },

    "parts" : {
      "bg" : {
        "properties" : {
          "centered" : false
        },

        "partStates" : {
          "switchState" : {
            "on" : {
              "properties" : {
                "image" : "<partImage>:on.<frame>",
                "fullbright" : true
              }
            },
            "off" : {
              "properties" : {
                "image" : "<partImage>:off",
                "fullbright" : true
              }
            },
            "error" : {
              "properties" : {
                "image" : "<partImage>:error",
                "fullbright" : true
              }
            },
            "dup" : {
              "properties" : {
                "image" : "<partImage>:dup",
                "fullbright" : true
              }
            },
            "dead" : {
              "properties" : {
                "image" : "<partImage>:dead"
              }
            }
          }
        }
      },
      "fg" : {
        "properties" : {
          "centered" : false,
          "zLevel" : 1
        },

        "partStates" : {
          "switchState" : {
            "on" : {
              "properties" : {
                "image" : "<partImage>:on.<frame>"
              }
            },
            "off" : {
              "properties" : {
                "image" : "<partImage>:off"
              }
            },
            "error" : {
              "properties" : {
                "image" : "<partImage>:error"
              }
            },
            "dup" : {
              "properties" : {
                "image" : "<partImage>:dup"
              }
            },
            "dead" : {
              "properties" : {
                "image" : "<partImage>:dead"
              }
            }
          }
        }
      }
    }
  },

  "lights" : {
    "activeGlow" : {
      "active" : false,
      "position" : [1, 1],
      "color" : [31, 40, 51]
    },
    "errorGlow" : {
      "active" : false,
      "position" : [1, 1],
      "color" : [51, 40, 31]
    }
  },

  "sounds" : {
    "on" : ["/sfx/interface/energy_full1.ogg"],
    "off" : ["/sfx/interface/energy_out1.ogg"],
    "error" : [],
    "dup" : [],
    "dead" : []
  }
}
