          "type" : "image",
          "file" : "/interface/scripted/rl_fieldcontrolconsole/headline.png",
          "position" : [14, 91],
          "zlevel" : 1
        },
        "lblHelp" : {
          "type" : "label",
          "position" : [14, 72],
          "hAnchor" : "left",
          "value" : "Choose a frequency."
        },
        "lblError" : {
          "type" : "label",
          "visible" : false,
          "position" : [14, 52],
          "hAnchor" : "left",
          "value" : "^red;Frequency is in use. Choose another.^reset;"
        }
      }
