  /*
   * Variable definitions
   */

  "regDungeonIdTemplate" : "^cyan;%s^reset;",
  "unregErrorTemplate" : "^red;Frequency %d is in use. Choose another.^reset;",
  "unregHelpTemplate" : "Choose a frequency from %d to %d.",
  "unregUnknownError" : "^red;Unknown error occurred.^reset;",

  "btnLockConfigImages" : {
    "false" : {
      "base" : "/interface/scripted/rl_fieldcontrolconsole/unlockedbutton.png",
      "hover" : "/interface/scripted/rl_fieldcontrolconsole/unlockedbuttonhover.png"
    },
    "true" : {
      "base" : "/interface/scripted/rl_fieldcontrolconsole/lockedbutton.png",
      "hover" : "/interface/scripted/rl_fieldcontrolconsole/lockedbuttonhover.png"
    }
  },

  "imgLockStatusImages" : {
    "false" : "/interface/scripted/rl_fieldcontrolconsole/unlocked.png",
    "true" : "/interface/scripted/rl_fieldcontrolconsole/locked.png"
  },

  "lblLockStatusValues" : {
    "false" : "^red;Console lock is not set.^reset;",
    "true" : "^cyan;Console lock is set.^reset;"
  },

  "lblBreathableValues" : {
    "false" : "^red;Atmospheric oxygen unavailable^reset;",
    "true" : "Breathable Atmosphere"
  },

  "lblGravityTemplate" : "Gravity (%d)",

  "lblHazardProtectValues" : [
    "^red;Environmental protection module unavailable^reset;",
    "^darkgray;No environmental hazards detected^reset;",
    "Environmental Protection"
  ],

  // This must be set to the min and max ranges of `ovlReg.sldGravity`.
  "sldGravityRange" : [0, 110],

  "sounds" : {
    "error" : "/sfx/interface/clickon_error.ogg",
    "lock" : "/sfx/objects/vendingmachine_close1.ogg",
    "unlock" : "/sfx/objects/vendingmachine_open1.ogg"
  },

  "visibilityModeButtons" : [
    "btnBulkheadMode",
    "btnHiddenMode"
  ],

  /*
   * Script declarations
   */

  "scripts" : [
    "/interface/scripted/rl_fieldcontrolconsole/rl_fieldcontrolconsolegui.lua"
  ],
  "scriptDelta" : 5,

  "scriptWidgetCallbacks" : [
    "btnActivatePressed",
    "btnBreathablePressed",
    "btnDeactivatePressed",
    "btnDismissLockConfigPressed",
    "btnGravityOverridePressed",
    "btnHazardProtectPressed",
    "btnLockConfigPressed",
    "btnPasswordResetPressed",
    "btnPasswordSetPressed",
    "btnRandomizePressed",
    "btnShieldingPressed",
    "btnUnlockPressed",
    "enterDungeonId",
    "enterNewPassword",
    "enterUnlockPassword",
    "setGravity",
    "setVisibilityMode"
  ]
}
