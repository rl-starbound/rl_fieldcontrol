    "ovlUnreg" : {
      "type" : "layout",
      "visible" : false,
      "layoutType" : "basic",
      "zlevel" : 1,
      "rect" : [1, 51, 230, 177],
      "children" : {
        "lblDungeonId" : {
          "type" : "label",
          "position" : [14, 102],
