{
  "gui" : {
    "background" : {
      "zlevel" : 0,
      "type" : "background",
      "fileHeader" : "/interface/scripted/rl_fieldcontrolconsole/header.png",
      "fileBody" : "/interface/scripted/rl_fieldcontrolconsole/body.png",
      "fileFooter" : "/interface/scripted/rl_fieldcontrolconsole/footer.png"
    },
    "windowtitle" : {
      "type" : "title",
      "title" : " Field Control Console",
      "subtitle" : " Take control of your environment",
      "icon" : {
        "type" : "image",
        "file" : "/interface/scripted/rl_fieldcontrolconsole/rl_fieldcontrolconsoleicon.png"
      },
      "zlevel" : -1
    },
    "imgShine" : {
      "type" : "image",
      "file" : "/interface/scripted/rl_fieldcontrolconsole/shine.png",
      "zlevel" : 1,
      "position" : [0, 8],
      "mouseTransparent" : true
    },
    "btnLockConfig" : {
      "zlevel" : 3,
      "type" : "button",
      "base" : "/interface/scripted/rl_fieldcontrolconsole/unlockedbutton.png",
      "hover" : "/interface/scripted/rl_fieldcontrolconsole/unlockedbuttonhover.png",
      "pressedOffset" : [0, 0],
      "position" : [185, 178],
      "callback" : "btnLockConfigPressed"
    },
    "btnDismissLockConfig" : {
      "zlevel" : 3,
      "type" : "button",
      "visible" : false,
      "base" : "/interface/scripted/rl_fieldcontrolconsole/back.png",
      "hover" : "/interface/scripted/rl_fieldcontrolconsole/backhover.png",
      "pressed" : "/interface/scripted/rl_fieldcontrolconsole/backpress.png",
      "pressedOffset" : [0, 0],
      "position" : [215, 181],
      "callback" : "btnDismissLockConfigPressed"
    },
    "close" : {
      "zlevel" : 3,
      "type" : "button",
      "base" : "/interface/x.png",
      "hover" : "/interface/xhover.png",
      "pressed" : "/interface/xpress.png",
      "pressedOffset" : [0, 0],
      "position" : [215, 181]
    },

    "ovlLockConfig" : {
      "type" : "layout",
      "visible" : false,
      "layoutType" : "basic",
      "zlevel" : 1,
      "rect" : [1, 51, 230, 177],
      "children" : {
        "lblLockStatus" : {
          "type" : "label",
          "position" : [14, 102],
          "hAnchor" : "left",
          "value" : "^red;Console lock is not set.^reset;"
        },
        "imgLockStatus" : {
          "type" : "image",
          "file" : "/interface/scripted/rl_fieldcontrolconsole/unlocked.png",
          "position" : [200, 98],
          "zlevel" : 1
        },
        "headline" : {
          "type" : "image",
          "file" : "/interface/scripted/rl_fieldcontrolconsole/headline.png",
          "position" : [14, 91],
          "zlevel" : 1
        },
        "lblNewPassword" : {
          "type" : "label",
          "position" : [14, 72],
          "hAnchor" : "left",
          "value" : "New Password"
        },
        "imgNewPassword" : {
          "type" : "image",
          "file" : "/interface/scripted/rl_fieldcontrolconsole/passwordbg.png",
          "position" : [92, 69],
          "zlevel" : 1
        },
        "newPassword" : {
          "type" : "textbox",
          "position" : [96, 72],
          "maxWidth" : 80,
          "fontSize" : 10,
          "zlevel" : 2,
          "callback" : "enterNewPassword",
          "nextFocus" : "newPassword2"
        },
        "imgNewPasswordCheck" : {
          "type" : "image",
          "visible" : false,
          "file" : "/interface/scripted/rl_fieldcontrolconsole/greencheck.png",
