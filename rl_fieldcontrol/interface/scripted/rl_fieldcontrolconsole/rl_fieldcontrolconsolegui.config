          "zlevel" : 1
        },
        "lblNewPassword2" : {
          "type" : "label",
          "position" : [14, 52],
          "hAnchor" : "left",
          "value" : "Repeat Password"
        },
        "imgNewPassword2" : {
          "type" : "image",
          "file" : "/interface/scripted/rl_fieldcontrolconsole/passwordbg.png",
          "position" : [92, 49],
          "zlevel" : 1
        },
        "newPassword2" : {
          "type" : "textbox",
          "position" : [96, 52],
          "maxWidth" : 80,
          "fontSize" : 10,
          "zlevel" : 2,
          "callback" : "enterNewPassword",
          "nextFocus" : "newPassword"
        },
        "imgNewPassword2Check" : {
          "type" : "image",
          "visible" : false,
